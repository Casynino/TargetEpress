# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL is the POOLED connection (…-pooler.…) used by the running app.
# DIRECT_URL is the DIRECT connection used by `prisma migrate` / `db push`.
# Both come from the Neon dashboard → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/targetexpress?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/targetexpress?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Only needed when the deployment URL is not auto-detected by Vercel.
# AUTH_URL="https://targetexpress.vercel.app"

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Primary WhatsApp/phone shown across the public site. The second Tanzanian
# number, both office addresses and the Guangzhou warehouse details live in
# lib/constants.ts (COMPANY) — edit them there.
NEXT_PUBLIC_COMPANY_PHONE="+255 688 887 784"
NEXT_PUBLIC_COMPANY_WHATSAPP="255688887784"
NEXT_PUBLIC_COMPANY_EMAIL="info@targetexpress.co.tz"

# ---------------------------------------------------------------------------
# Cargo photo uploads (Vercel Blob). Optional in development — without it the
# shipment form simply hides the photo uploader.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ---------------------------------------------------------------------------
# Seed — the first CEO/Admin account. Change the password after first login.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="ceo@targetexpress.co.tz"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
